<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Get Well Soon, Mansha! 💖🌸 | Warm Healing Wishes</title>
  <meta name="description" content="A special get well soon webpage crafted with warm wishes for Mansha. Wishing you a super speedy and peaceful recovery!">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- Floating Health Icons Motion Background Layer (Scroll Parallax) -->
  <div id="motion-bg-container" aria-hidden="true">
    <canvas id="health-canvas"></canvas>
    
    <!-- Parallax SVG Health Icons -->
    <div class="parallax-icon icon-cross layer-1" data-speed="0.15" style="top: 10%; left: 8%;">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2a1 1 0 0 1 2 0v7h7a1 1 0 0 1 0 2h-7v7a1 1 0 0 1-2 0v-7H4a1 1 0 0 1 0-2h7V2z"/></svg>
    </div>
    <div class="parallax-icon icon-heart layer-2" data-speed="-0.25" style="top: 18%; right: 10%;">
      <svg viewBox="0 0 24 24" width="54" height="54" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
    </div>
    <div class="parallax-icon icon-pill layer-3" data-speed="0.35" style="top: 32%; left: 4%;">
      <svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7z"/><path d="M8.5 8.5l7 7"/></svg>
    </div>
    <div class="parallax-icon icon-pulse layer-1" data-speed="-0.1" style="top: 42%; right: 6%;">
      <svg viewBox="0 0 24 24" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    </div>
    <div class="parallax-icon icon-stethoscope layer-2" data-speed="0.22" style="top: 55%; left: 7%;">
      <svg viewBox="0 0 24 24" width="52" height="52" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
    </div>
    <div class="parallax-icon icon-flower layer-3" data-speed="-0.3" style="top: 68%; right: 8%;">
      <svg viewBox="0 0 24 24" width="50" height="50" fill="currentColor"><path d="M12 2a4 4 0 0 0-4 4c0 1.6.9 3 2.2 3.6C8.9 9.9 8 10.8 8 12a4 4 0 0 0 4 4c1.2 0 2.1-.9 2.4-2.2 1.3.3 2.4-.6 2.4-2.2a4 4 0 0 0-4-4c-1.6 0-3 .9-3.6 2.2C8.9 8.9 8 8 8 6.4a4 4 0 0 0 4-4.4z"/><circle cx="12" cy="12" r="3" fill="#ffd166"/></svg>
    </div>
    <div class="parallax-icon icon-bandage layer-1" data-speed="0.18" style="top: 78%; left: 5%;">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="6" transform="rotate(-45 12 12)"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="9.5" cy="12" r="1.5" fill="currentColor"/><circle cx="14.5" cy="12" r="1.5" fill="currentColor"/></svg>
    </div>
    <div class="parallax-icon icon-cross layer-2" data-speed="-0.2" style="top: 88%; right: 12%;">
      <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2a1 1 0 0 1 2 0v7h7a1 1 0 0 1 0 2h-7v7a1 1 0 0 1-2 0v-7H4a1 1 0 0 1 0-2h7V2z"/></svg>
    </div>
  </div>

  <!-- Top Sticky Navigation & Audio Control Bar -->
  <header class="top-nav">
    <div class="logo-area">
      <span class="pulse-dot"></span>
      <span class="logo-text">CareForMansha<span>.health</span></span>
    </div>
    
    <!-- Heart Rhythm Monitor Header Widget -->
    <div class="header-ecg">
      <svg class="ecg-line" viewBox="0 0 200 40">
        <path d="M0,20 L30,20 L35,10 L40,30 L45,5 L50,35 L55,20 L90,20 L95,12 L100,28 L105,8 L110,32 L115,20 L160,20 L165,14 L170,26 L175,20 L200,20" />
      </svg>
      <span class="ecg-label">Rest Mode Active 💤</span>
    </div>

    <div class="nav-controls">
      <button id="sound-toggle-btn" class="icon-btn" aria-label="Toggle soothing ambient music" title="Play soothing background sound">
        <span class="sound-icon">🎵</span>
        <span class="sound-text">Ambient Sound</span>
      </button>
      <button id="hug-quick-btn" class="pill-btn highlight-btn">
        <span class="btn-heart">✨</span> Send Healing Vibes
      </button>
    </div>
  </header>

  <!-- Main Container -->
  <main class="content-wrapper">

    <!-- HERO SECTION -->
    <section class="hero-section" id="hero">
      <div class="hero-glass-card">
        <div class="hero-badge">
          <span class="badge-icon">🌟</span>
          <span class="badge-text">Dedicated to Dear Mansha</span>
        </div>

        <h1 class="hero-title">
          Get Well Soon, <span class="gradient-name">Mansha!</span>
        </h1>

        <p class="hero-subtitle">
          Sending you endless sunshine, cozy comfort, warm tea, and a gentle reminder to take all the time you need. Rest up, take it easy, and let your body heal! 🌸✨
        </p>

        <div class="hero-image-frame">
          <img src="assets/hero.jpg" alt="Get Well Soon Warm Illustration for Mansha" class="hero-img">
          <div class="image-overlay-glow"></div>
        </div>

        <div class="hero-actions">
          <button id="hug-main-btn" class="primary-btn pulse-glow">
            <span class="btn-icon">✨</span>
            <span class="btn-text">Send Healing Energy!</span>
          </button>
          <a href="#prescription" class="secondary-btn">
            <span class="btn-icon">📋</span>
            <span class="btn-text">View Your Doctor's Rx</span>
          </a>
        </div>
      </div>
    </section>

    <!-- MANSHA'S HEALTH RECOVERY MONITOR DASHBOARD -->
    <section class="dashboard-section" id="dashboard">
      <div class="section-header">
        <h2 class="section-title">✨ Mansha's Recovery Status</h2>
        <p class="section-desc">Real-time status monitor filled 100% with positivity and warm vibes</p>
      </div>

      <div class="dashboard-grid">
        <div class="stat-card glass-panel">
          <div class="stat-header">
            <span class="stat-icon">🛌</span>
            <span class="stat-tag">Rest Index</span>
          </div>
          <div class="stat-body">
            <span class="stat-value">100%</span>
            <span class="stat-sub">Max Comfort Required</span>
          </div>
          <div class="stat-bar-container">
            <div class="stat-bar-fill" style="width: 100%;"></div>
          </div>
        </div>

        <div class="stat-card glass-panel">
          <div class="stat-header">
            <span class="stat-icon">💌</span>
            <span class="stat-tag">Support & Cheer</span>
          </div>
          <div class="stat-body">
            <span class="stat-value">100%</span>
            <span class="stat-sub">Off the Charts!</span>
          </div>
          <div class="stat-bar-container">
            <div class="stat-bar-fill pulse-fill" style="width: 100%;"></div>
          </div>
        </div>

        <div class="stat-card glass-panel">
          <div class="stat-header">
            <span class="stat-icon">💊</span>
            <span class="stat-tag">Prescription Dose</span>
          </div>
          <div class="stat-body">
            <span class="stat-value">Unlimited</span>
            <span class="stat-sub">Good Vibes, Tea & Smiles</span>
          </div>
          <div class="stat-bar-container">
            <div class="stat-bar-fill" style="width: 90%;"></div>
          </div>
        </div>

        <div class="stat-card glass-panel">
          <div class="stat-header">
            <span class="stat-icon">⚡</span>
            <span class="stat-tag">Energy Recharge</span>
          </div>
          <div class="stat-body">
            <span id="energy-counter" class="stat-value">75%</span>
            <span class="stat-sub">Restoring Strength...</span>
          </div>
          <div class="stat-bar-container">
            <div id="energy-bar" class="stat-bar-fill gold-fill" style="width: 75%;"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- MANSHA'S FULL RECOVERY COUNTDOWN TIMER -->
    <section class="countdown-section" id="recovery-countdown">
      <div class="countdown-card glass-panel">
        <div class="countdown-header">
          <span class="countdown-badge">⏳ Recovery Milestone</span>
          <h2>Countdown to Mansha's Full Recovery Party! 🎉</h2>
          <p>Resting, recharging, and counting down to 100% health & energy!</p>
        </div>

        <div class="countdown-timer-grid">
          <div class="timer-box">
            <span id="timer-days" class="timer-num">05</span>
            <span class="timer-unit">Days</span>
          </div>
          <div class="timer-separator">:</div>
          <div class="timer-box">
            <span id="timer-hours" class="timer-num">12</span>
            <span class="timer-unit">Hours</span>
          </div>
          <div class="timer-separator">:</div>
          <div class="timer-box">
            <span id="timer-minutes" class="timer-num">45</span>
            <span class="timer-unit">Minutes</span>
          </div>
          <div class="timer-separator">:</div>
          <div class="timer-box">
            <span id="timer-seconds" class="timer-num">30</span>
            <span class="timer-unit">Seconds</span>
          </div>
        </div>

        <div class="countdown-footer">
          <span class="countdown-target-info">Target Date: <strong id="target-date-display">Resting & Recharging</strong></span>
          <button id="customize-timer-btn" class="pill-btn secondary-pill">📅 Set Target Date</button>
        </div>
      </div>
    </section>

    <!-- OFFICIAL DOCTOR'S PRESCRIPTION FOR MANSHA -->
    <section class="prescription-section" id="prescription">
      <div class="rx-card glass-panel">
        <div class="rx-header">
          <div class="rx-symbol-box">
            <span class="rx-symbol">Rx</span>
          </div>
          <div class="rx-meta">
            <h3>Official Doctor's Healing Prescription</h3>
            <p>Patient Name: <strong>Mansha</strong> | Date: <strong>Today & Everyday</strong></p>
          </div>
          <div class="rx-stamp">CERTIFIED CARE & WELLNESS 🌟</div>
        </div>

        <div class="rx-body">
          <p class="rx-intro">Please execute the following medical orders for a speedy recovery:</p>
          
          <ul class="checklist" id="rx-checklist">
            <li class="checklist-item" data-id="1">
              <label class="custom-checkbox">
                <input type="checkbox" id="chk-1">
                <span class="checkmark"></span>
                <span class="item-text"><strong>Drink warm water or soothing chamomile tea</strong> 🍵 (Hydration is key!)</span>
              </label>
            </li>
            <li class="checklist-item" data-id="2">
              <label class="custom-checkbox">
                <input type="checkbox" id="chk-2">
                <span class="checkmark"></span>
                <span class="item-text"><strong>Zero stressful thoughts allowed!</strong> 🚫🧠 (Only calm and peaceful thoughts)</span>
              </label>
            </li>
            <li class="checklist-item" data-id="3">
              <label class="custom-checkbox">
                <input type="checkbox" id="chk-3">
                <span class="checkmark"></span>
                <span class="item-text"><strong>Watch your favorite cozy movie or read a lovely book</strong> 🎬📖</span>
              </label>
            </li>
            <li class="checklist-item" data-id="4">
              <label class="custom-checkbox">
                <input type="checkbox" id="chk-4">
                <span class="checkmark"></span>
                <span class="item-text"><strong>Take deep, relaxing breaths & extra nap time</strong> 💤</span>
              </label>
            </li>
            <li class="checklist-item" data-id="5">
              <label class="custom-checkbox">
                <input type="checkbox" id="chk-5">
                <span class="checkmark"></span>
                <span class="item-text"><strong>Remember that everyone is rooting for your fast recovery!</strong> 🌟</span>
              </label>
            </li>
          </ul>

          <div class="rx-progress-wrapper">
            <div class="rx-progress-info">
              <span>Healing Goals Completed:</span>
              <strong id="rx-status-text">0 of 5 checked</strong>
            </div>
            <div class="rx-progress-track">
              <div id="rx-progress-bar" class="rx-progress-fill" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <div class="rx-footer">
          <div class="doctor-signature">
            <span class="sig-font">Dr. Arsalan, M.D.</span>
            <span class="sig-sub">Specialist in Smiles & Sunshine</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE CARE PACKAGE & REMEDY PICKER -->
    <section class="care-package-section" id="care-package">
      <div class="section-header">
        <h2 class="section-title">💐 Pick a Healing Remedy for Mansha</h2>
        <p class="section-desc">Click any remedy below to activate instant cozy vibes!</p>
      </div>

      <div class="remedies-grid">
        <!-- Remedy 1: Steaming Tea -->
        <div class="remedy-card glass-panel" id="remedy-tea">
          <div class="remedy-icon-wrapper">
            <span class="remedy-emoji tea-emoji">🍵</span>
            <div class="tea-steam">
              <span>~</span><span>~</span><span>~</span>
            </div>
          </div>
          <h3>Warm Lemon Honey Tea</h3>
          <p>Soothes your throat and warms your soul with natural sweet citrus goodness.</p>
          <button class="remedy-btn" onclick="triggerRemedy('tea')">Serve Fresh Cup ☕</button>
        </div>

        <!-- Remedy 2: Flower Bouquet -->
        <div class="remedy-card glass-panel" id="remedy-flowers">
          <div class="remedy-icon-wrapper">
            <span class="remedy-emoji flower-emoji">🌸</span>
          </div>
          <h3>Fresh Bloom Bouquet</h3>
          <p>A hand-picked selection of fragrant peonies and roses to brighten your room.</p>
          <button class="remedy-btn" onclick="triggerRemedy('flowers')">Send Flowers 💐</button>
        </div>

        <!-- Remedy 3: Cozy Teddy Bear -->
        <div class="remedy-card glass-panel" id="remedy-teddy">
          <div class="remedy-icon-wrapper">
            <span class="remedy-emoji teddy-emoji">🧸</span>
          </div>
          <h3>Cozy Plushie Comfort</h3>
          <p>The softest plush companion to keep you extra warm during nap times.</p>
          <button class="remedy-btn" onclick="triggerRemedy('teddy')">Send Comfort 🧸</button>
        </div>

        <!-- Remedy 4: Vitamin Sunshine -->
        <div class="remedy-card glass-panel" id="remedy-sun">
          <div class="remedy-icon-wrapper">
            <span class="remedy-emoji sun-emoji">☀️</span>
          </div>
          <h3>Golden Sunshine Rays</h3>
          <p>Direct vitamin C & D boost to power up your immune system and elevate your mood!</p>
          <button class="remedy-btn" onclick="triggerRemedy('sun')">Shine Sun 🌞</button>
        </div>
      </div>
    </section>

    <!-- MINI BOOSTER GAME: VITAMIN CATCHER FOR MANSHA -->
    <section class="game-section" id="booster-game">
      <div class="game-card glass-panel">
        <div class="game-header">
          <div>
            <span class="game-badge">🎮 Interactive Care Mini-Game</span>
            <h2>Boost Mansha's Health Meter!</h2>
            <p>Click or tap the floating wellness icons (💊, 🍋, 💖, 🌸, 🍵) to boost Mansha's strength!</p>
          </div>
          <div class="score-box">
            <span class="score-title">Health Boosts</span>
            <span id="game-score" class="score-num">0</span>
          </div>
        </div>

        <div id="game-canvas-area" class="game-area">
          <div id="game-start-overlay" class="game-overlay">
            <div class="overlay-content">
              <span class="overlay-icon">⚡</span>
              <h3>Ready to Catch Vitality Icons?</h3>
              <p>Help charge Mansha's energy to 100%!</p>
              <button id="start-game-btn" class="primary-btn">Start Health Boost 🚀</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WALL OF WARM WISHES FOR MANSHA -->
    <section class="wishes-section" id="wishes">
      <div class="section-header">
        <h2 class="section-title">💌 Messages & Warm Wishes for Mansha</h2>
        <p class="section-desc">Heartfelt words to bring a big bright smile to Mansha's face</p>
      </div>

      <!-- Add Wish Form -->
      <div class="add-wish-card glass-panel">
        <h3>Pin a Wishing Note for Mansha ✨</h3>
        <form id="wish-form">
          <div class="form-row">
            <input type="text" id="sender-name" placeholder="Your Name or Nickname" required maxlength="30">
            <select id="wish-emoji">
              <option value="✨">✨ Warm Care & Cheer</option>
              <option value="🌸">🌸 Flower Power</option>
              <option value="🍵">🍵 Warm Comfort</option>
              <option value="⭐">⭐ Sparkle & Shine</option>
              <option value="🧸">🧸 Cozy Comfort</option>
              <option value="💊">💊 Speedy Healing</option>
            </select>
          </div>
          <div class="form-row">
            <textarea id="wish-message" placeholder="Write your warm message to Mansha here..." required maxlength="250" rows="3"></textarea>
          </div>
          <button type="submit" class="primary-btn">Pin Note to Board 📌</button>
        </form>
      </div>

      <!-- Wishes Grid -->
      <div class="wishes-grid" id="wishes-container">
        <!-- Default Preloaded Wishes -->
        <div class="wish-card glass-panel color-1">
          <div class="wish-card-header">
            <span class="wish-sender">From your Besties</span>
            <span class="wish-emoji">🌟</span>
          </div>
          <p class="wish-text">"Dear Mansha, we miss your laugh and bright energy so much! Please rest well, eat good food, and recover soon! Can't wait to hang out!"</p>
          <span class="wish-date">Today</span>
        </div>

        <div class="wish-card glass-panel color-2">
          <div class="wish-card-header">
            <span class="wish-sender">Sunshine Squad</span>
            <span class="wish-emoji">🌸</span>
          </div>
          <p class="wish-text">"Sending you a garden full of healing flowers! May every day bring you more strength, comfort, and peaceful sleep. Get well soon Mansha!"</p>
          <span class="wish-date">Today</span>
        </div>

        <div class="wish-card glass-panel color-3">
          <div class="wish-card-header">
            <span class="wish-sender">Team Cozy</span>
            <span class="wish-emoji">🍵</span>
          </div>
          <p class="wish-text">"Here is an official order for unlimited hot tea, cozy blankets, and warm socks. You'll be back on your feet glowing in no time!"</p>
          <span class="wish-date">Today</span>
        </div>
      </div>
    </section>

    <!-- FOOTER SECTION -->
    <footer class="site-footer">
      <div class="footer-glass">
        <div class="footer-heart">✨</div>
        <h3>Crafted with Warm Wishes for Mansha</h3>
        <p>May your recovery be smooth, speedy, and filled with sweet comfort every single day!</p>
        <div class="footer-copy">© Get Well Soon Mansha | Health & Positivity Portal</div>
      </div>
    </footer>

  </main>

  <!-- Interactive Fullscreen Celebration Modal / Energy Effect -->
  <div id="hug-modal" class="modal-overlay" aria-hidden="true">
    <div class="modal-content glass-panel">
      <button id="modal-close" class="modal-close-btn">&times;</button>
      <div class="modal-body">
        <div class="hug-animation-box">
          <span class="big-hug-emoji">✨🌸🌟</span>
        </div>
        <h2>Healing Energy Sent to Mansha!</h2>
        <p>A double dose of warm cheer and bright recovery energy has been sent your way! Rest well, stay hydrated, and get back on your feet soon!</p>
        <button onclick="closeModal()" class="primary-btn">Thank You! 😊</button>
      </div>
    </div>
  </div>

  <!-- Mobile Bottom Action Bar (Dock for Thumb Navigation) -->
  <nav class="mobile-bottom-dock" aria-label="Mobile Navigation">
    <a href="#hero" class="dock-item active">
      <span class="dock-icon">🏠</span>
      <span class="dock-label">Home</span>
    </a>
    <a href="#recovery-countdown" class="dock-item">
      <span class="dock-icon">⏳</span>
      <span class="dock-label">Timer</span>
    </a>
    <a href="#prescription" class="dock-item">
      <span class="dock-icon">📋</span>
      <span class="dock-label">Doctor Rx</span>
    </a>
    <a href="#care-package" class="dock-item">
      <span class="dock-icon">💐</span>
      <span class="dock-label">Remedies</span>
    </a>
    <a href="#booster-game" class="dock-item">
      <span class="dock-icon">🎮</span>
      <span class="dock-label">Game</span>
    </a>
    <a href="#wishes" class="dock-item">
      <span class="dock-icon">💌</span>
      <span class="dock-label">Wishes</span>
    </a>
  </nav>

  <!-- JavaScript Script Link -->
  <script src="script.js"></script>
</body>
</html>
